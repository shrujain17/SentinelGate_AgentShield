# AgentShield local runtime configuration
# AI_PROVIDER=mock works offline and does not require a model API key.
AI_PROVIDER=mock
GEMINI_API_KEY=

# Upload controls. Values above 50 are capped; minimum is 1 MB.
AGENTSHIELD_MAX_UPLOAD_MB=12

# Optional. Defaults to the project-local SQLite database.
# DATABASE_URL=sqlite:///./agentshield.db

# Gateway bind configuration is deliberately localhost-only by default.
AGENTSHIELD_HOST=127.0.0.1
AGENTSHIELD_PORT=8000

# Comma-separated allowed browser origins (local dashboard/Vite origins by default)
AGENTSHIELD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
